<%@ page pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<header class="site-header">
    <div class="container header-inner">
        <a class="brand" href="${pageContext.request.contextPath}/home"><span class="brand-mark" aria-hidden="true">H</span>HNH<span>BOOKSTORE</span></a>
        <nav aria-label="Điều hướng chính">
            <a href="${pageContext.request.contextPath}/home">Trang chủ</a>
            <a href="${pageContext.request.contextPath}/home#catalog">Sản phẩm</a>
            <a href="${pageContext.request.contextPath}/cart" class="cart-nav-link">
                Giỏ hàng <c:if test="${not empty sessionScope.cart && sessionScope.cart.totalQuantity > 0}"><span class="badge-cart">${sessionScope.cart.totalQuantity}</span></c:if>
            </a>
            <c:if test="${sessionScope.currentUser.admin}"><a href="${pageContext.request.contextPath}/admin/books">Trang quản trị</a></c:if>
            <c:choose>
                <c:when test="${not empty sessionScope.currentUser}">
                    <span class="user-name"><c:out value="${sessionScope.currentUser.fullname}"/></span>
                    <form method="post" action="${pageContext.request.contextPath}/logout" class="inline-form">
                        <input type="hidden" name="csrf" value="<c:out value='${sessionScope.csrf}'/>">
                        <button class="button button-outline" type="submit">Đăng xuất</button>
                    </form>
                </c:when>
                <c:otherwise>
                    <a href="${pageContext.request.contextPath}/register">Đăng ký</a>
                    <a class="button button-outline" href="${pageContext.request.contextPath}/login">Đăng nhập</a>
                </c:otherwise>
            </c:choose>
        </nav>
    </div>
</header>
